APP_NAME=AfyaSync API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://afasync:afasync@localhost:5432/afasync
JWT_SECRET=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15

# Production requirements:
# ENVIRONMENT=production
# JWT_SECRET must be a strong secret of at least 32 characters
# DATABASE_URL must point to the managed PostgreSQL instance
# Schema changes must be applied with Alembic only (create_all is disabled in production)
