APP_NAME=AfyaSync API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://afasync:afasync@localhost:5432/afasync
JWT_SECRET=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WORKER_POLL_SECONDS=5

# Optional authorised DHIS2 aggregate mapping (production values must come from the target instance)
# DHIS2_DATASET_ID=<dataset-id>
# DHIS2_DATA_ELEMENT_ENCOUNTERS=<data-element-id>
# DHIS2_DATA_ELEMENT_REGISTERED_PATIENTS=<data-element-id>
# DHIS2_DATA_ELEMENT_INVOICES=<data-element-id>
# DHIS2_DATA_ELEMENT_PAYMENTS=<data-element-id>
# DHIS2_DATA_ELEMENT_CLAIMS=<data-element-id>

# Production requirements:
# ENVIRONMENT=production
# JWT_SECRET must be a strong secret of at least 32 characters
# DATABASE_URL must point to the managed PostgreSQL instance
# CORS_ORIGINS must list only trusted HTTPS frontend origins (comma-separated)
# WORKER_POLL_SECONDS must be positive; run the integration worker as a separate process
# Schema changes must be applied with Alembic only (create_all is disabled in production)
# Provider credentials must be supplied through environment variables referenced by integration configuration
